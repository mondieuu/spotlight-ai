<Window x:Class="Odak.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spotlight AI"
        Width="800"
        Height="620"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        PreviewMouseDown="OnWindowMouseDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="Fg" Color="White" />
        <SolidColorBrush x:Key="FgDim" Color="#99FFFFFF" />
        <SolidColorBrush x:Key="Tint" Color="#661C1C1E" />
        <SolidColorBrush x:Key="Accent" Color="#A8C7FA" />
        <SolidColorBrush x:Key="Chip" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="NoChip" Color="Transparent" />
        <SolidColorBrush x:Key="Hairline" Color="#26FFFFFF" />

        <LinearGradientBrush x:Key="Rim" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#66FFFFFF" Offset="0" />
            <GradientStop Color="#1AFFFFFF" Offset="0.22" />
            <GradientStop Color="#08FFFFFF" Offset="0.5" />
            <GradientStop Color="#1AFFFFFF" Offset="0.8" />
            <GradientStop Color="#40FFFFFF" Offset="1" />
        </LinearGradientBrush>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="MinWidth" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="0,4,2,4">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="3" Width="6" Background="{DynamicResource FgDim}" Opacity="0.45" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="9" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Panel" Margin="40,24,40,0" VerticalAlignment="Top" Height="68" Opacity="0" RenderTransformOrigin="0.5,0">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="PanelScale" ScaleX="0.94" ScaleY="0.94" />
        </Grid.RenderTransform>
        <Border CornerRadius="28" Background="Black">
            <Border.Effect>
                <DropShadowEffect BlurRadius="56" ShadowDepth="16" Direction="270" Opacity="0.38" RenderingBias="Performance" />
            </Border.Effect>
        </Border>
        <Border x:Name="Glass" CornerRadius="28" Background="Transparent" />
        <Border CornerRadius="28" Background="{DynamicResource Tint}" />
        <Border CornerRadius="28" BorderThickness="1" BorderBrush="{StaticResource Rim}" IsHitTestVisible="False" />

        <Canvas x:Name="ContentHost" ClipToBounds="True" SizeChanged="OnContentHostSizeChanged">
            <StackPanel x:Name="ContentStack" Width="720" SizeChanged="OnContentSizeChanged">
                <Grid Height="68" Margin="24,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path Width="24" Height="24" Stretch="Uniform" Fill="{DynamicResource FgDim}" VerticalAlignment="Center" HorizontalAlignment="Left" Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0016 9.5 6.5 6.5 0 109.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
                    <TextBlock x:Name="Placeholder" Margin="38,0,0,0" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="22"
                               Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBox x:Name="Query" Margin="36,0,0,0" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="22"
                             Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Fg}" CaretBrush="{DynamicResource Accent}" SelectionBrush="{DynamicResource Accent}"
                             MaxLength="20000" TextChanged="OnQueryChanged" PreviewKeyDown="OnQueryKeyDown" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Button x:Name="SettingsButton" Style="{StaticResource HeaderButton}" Margin="0" Padding="0"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE713;" Click="OnSettingsClicked" />
                    </StackPanel>
                </Grid>
                <Border x:Name="Divider" Height="1" Margin="20,0" Background="{DynamicResource Hairline}" Visibility="Collapsed" />
                <ScrollViewer x:Name="AnswerScroll" Visibility="Collapsed" MaxHeight="440" Margin="0,10,6,14"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBox x:Name="Answer" Margin="24,0,16,0" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource Fg}" CaretBrush="Transparent" SelectionBrush="{DynamicResource Accent}" FontSize="15"
                             PreviewKeyDown="OnAnswerKeyDown" />
                </ScrollViewer>
            </StackPanel>
        </Canvas>
    </Grid>
</Window>
