<Window x:Class="Odak.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spotlight AI"
        Width="940"
        Height="800"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True"
        PreviewMouseDown="OnWindowMouseDown">

    <!-- Not a layered window: Windows refuses to exclude those from screen capture, which the live glass needs.
         The sites are drawn with WebView2CompositionControl, so their corners can fade into the glass. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="-1" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="Fg" Color="White" />
        <SolidColorBrush x:Key="FgDim" Color="#99FFFFFF" />
        <SolidColorBrush x:Key="Tint" Color="#421C1C1E" />
        <SolidColorBrush x:Key="Chip" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="NoChip" Color="Transparent" />

        <LinearGradientBrush x:Key="Rim" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#66FFFFFF" Offset="0" />
            <GradientStop Color="#1AFFFFFF" Offset="0.22" />
            <GradientStop Color="#08FFFFFF" Offset="0.5" />
            <GradientStop Color="#1AFFFFFF" Offset="0.8" />
            <GradientStop Color="#40FFFFFF" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="10" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Panel" Margin="40,24,40,0" VerticalAlignment="Top" Height="68" Opacity="0" RenderTransformOrigin="0.5,0">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="PanelScale" ScaleX="0.94" ScaleY="0.94" />
        </Grid.RenderTransform>
        <Border CornerRadius="28" Background="Black">
            <Border.Effect>
                <DropShadowEffect BlurRadius="56" ShadowDepth="16" Direction="270" Opacity="0.38" RenderingBias="Performance" />
            </Border.Effect>
        </Border>
        <Border x:Name="Glass" CornerRadius="28" Background="Transparent" />
        <Border CornerRadius="28" Background="{DynamicResource Tint}" />
        <Border CornerRadius="28" BorderThickness="1" BorderBrush="{StaticResource Rim}" IsHitTestVisible="False" />

        <Canvas x:Name="ContentHost" ClipToBounds="True">
            <Grid x:Name="Content" Width="860">
                <Grid.RowDefinitions>
                    <RowDefinition Height="68" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="24,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Path Width="24" Height="24" Stretch="Uniform" Fill="{DynamicResource FgDim}" VerticalAlignment="Center" HorizontalAlignment="Left" Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0016 9.5 6.5 6.5 0 109.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
                    <TextBlock x:Name="Placeholder" Margin="38,0,0,0" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="22"
                               Foreground="{DynamicResource FgDim}" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBox x:Name="Query" Margin="36,0,0,0" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="22"
                             Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Fg}" CaretBrush="#0A84FF"
                             MaxLength="20000" TextChanged="OnQueryChanged" PreviewKeyDown="OnQueryKeyDown" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button x:Name="ChatGptButton" Style="{StaticResource HeaderButton}" Content="ChatGPT" Click="OnChatGptClicked" />
                        <Button x:Name="GeminiButton" Style="{StaticResource HeaderButton}" Content="Gemini" Click="OnGeminiClicked" />
                        <Button x:Name="ReloadButton" Style="{StaticResource HeaderButton}" Padding="0"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE72C;" Click="OnReloadClicked" />
                        <Button x:Name="SettingsButton" Style="{StaticResource HeaderButton}" Margin="0" Padding="0"
                                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Content="&#xE713;" Click="OnSettingsClicked" />
                    </StackPanel>
                </Grid>
                <Grid x:Name="WebHost" Grid.Row="1" Margin="14,0,14,14" Visibility="Collapsed" SizeChanged="OnWebHostSizeChanged" />
                <TextBlock x:Name="Message" Grid.Row="1" Visibility="Collapsed" Foreground="White" Background="#E61C1C1E" Padding="14,8" FontSize="14" TextWrapping="Wrap"
                           TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="60,8,60,0" />
            </Grid>
        </Canvas>
    </Grid>
</Window>
